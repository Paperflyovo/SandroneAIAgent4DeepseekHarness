{
  "name": "sandrone-ai-agent-for-deepseek-harness",
  "version": "0.1.3",
  "private": true,
  "main": "apps/desktop/main.cjs",
  "description": "Sandrone desktop distribution of the official DeepSeek Harness.",
  "author": "Sandrone contributors",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "build": "pnpm run preflight && pnpm run build:ui && pnpm run verify:ui-sync && pnpm run verify:architecture && pnpm run verify:upstream && pnpm run verify:skill",
    "preflight": "node scripts/preflight.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "verify:ui-sync": "node scripts/verify-ui-sync.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:upstream": "node scripts/verify-upstream.mjs",
    "verify:skill": "node scripts/verify-skill.mjs",
    "test": "node --test tests/*.test.mjs",
    "qa:web": "node scripts/qa-web.mjs",
    "qa:desktop": "node scripts/qa-electron.mjs",
    "web": "pnpm run build:ui && node scripts/run-web.mjs",
    "web:dump": "pnpm run build:ui && node scripts/run-web.mjs --dump-config",
    "desktop": "pnpm run build:ui && electron apps/desktop/main.cjs",
    "desktop:pack": "pnpm run build && pnpm test && node scripts/package-desktop.mjs",
    "desktop:dir": "node scripts/package-desktop.mjs --dir"
  },
  "dependencies": {
    "@sandrone/harness-ui": "workspace:*",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.6",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-base": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-directory-picker-browse": "0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-directory-picker-browse": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-output-retention": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.6",
    "@deepseek-ai/dsh-spill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-web-app": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.0-rc.6",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0"
  }
}
